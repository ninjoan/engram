package dashboard

import "time"

// AdminBackupsPage renders the admin Backups surface: the on-demand download,
// the external destination and weekday/time schedule, "Back up now", the run
// history, and what a backup archive contains and excludes.
//
// Every route behind its forms is owned by internal/cloud/cloudserver, which
// enforces the managed-admin policy, the same-origin check and the audit
// trail; this page only renders forms for sessions that hold that capability.
// Controls appear only when they map to a real action: the settings forms
// need ENGRAM_CLOUD_BACKUP_KEY, the schedule needs a destination, and
// "Back up now" needs a backup runner. What a backup contains is a
// plain-language summary grouped from cloudstore.BackupTables() and
// BackupExclusions(), with the exact lists in a collapsed "Technical
// details". A stored credential is never rendered;
// only the masked access key id hint is. There is deliberately no restore
// control: archives are unsigned, so restore stays an operator-only CLI
// (engram cloud backup import).
templ AdminBackupsPage(v BackupsPageView) {
	<section class="frame-section">
		<div class="section-header">
			<div>
				<p class="section-kicker">ADMIN SURFACE</p>
				<h2>Backups</h2>
			</div>
		</div>
		@adminNav("backups")
		if n := v.pageNotice(); n.Kind != "" {
			<div class={ backupNoticeClass(n.Kind) } role="status">
				<p>{ n.Message }</p>
			</div>
		}
		<div class="data-frame">
			<p class="section-kicker">DOWNLOAD BACKUP</p>
			<p>One gzip-compressed tar archive of every project's memories and the Cloud state, read from a single consistent database snapshot. Its <code>backup.json</code> manifest, written last, records each table's row count and SHA-256 checksum.</p>
			if v.CanManage {
				<form method="post" action="/dashboard/admin/backups/download" class="managed-user-form">
					<button type="submit">Download backup</button>
				</form>
				<p class="muted">Every download is recorded in the audit log as <code>backup.download</code> before the archive is sent.</p>
			}
		</div>
		if !v.CanManage {
			@BackupDownloadAdministrationNotice()
		}
		<div class="data-frame policy-note danger-note">
			<p><strong>The archive holds plaintext memories.</strong> Observations, prompts, and audit history are stored unencrypted. Treat it like a database dump: restrict who can read it and encrypt it before copying it off this machine.</p>
		</div>
		<h3 class="section-block-title">Scheduled backups</h3>
		@backupScheduledSection(v)
		@backupContents(v)
		<h3 class="section-block-title">Restore</h3>
		<p class="muted">Restoring is operator-only: run <code>engram cloud backup import</code> against a fresh database. The dashboard never restores archives because they are not signed.</p>
	</section>
}

// backupContents says in plain language what a backup holds and never
// holds, with the exact table and column lists collapsed below.
templ backupContents(v BackupsPageView) {
	<h3 class="section-block-title">What a backup contains</h3>
	<div class="backup-contents">
		<section class="backup-contents-group is-included" aria-labelledby="backup-included-title">
			<h4 id="backup-included-title">Included</h4>
			<ul class="backup-contents-list">
				for _, g := range v.backupContentsIncluded() {
					<li><span class="backup-contents-mark" aria-hidden="true">✓</span><span class="backup-contents-text"><strong>{ g.Label }</strong></span></li>
				}
			</ul>
		</section>
		<section class="backup-contents-group is-excluded" aria-labelledby="backup-excluded-title">
			<h4 id="backup-excluded-title">Never included</h4>
			<ul class="backup-contents-list">
				for _, g := range v.backupContentsExcluded() {
					<li><span class="backup-contents-mark" aria-hidden="true">✕</span><span class="backup-contents-text"><strong>{ g.Label }</strong>{ backupContentsDetail(g.Detail) }@backupEnvVarList(g.EnvVars)</span></li>
				}
			</ul>
		</section>
	</div>
	<details class="tech-details"><summary>{ v.backupTechnicalDetailsLabel() }</summary>
		<p class="muted">The exact tables and columns, as recorded in the archive's <code>backup.json</code> manifest.</p>
		<h4 class="tech-details-title">Tables included</h4>
		<table class="data-table">
			<tbody>
				for _, table := range v.Tables {
					<tr><td><code>{ table }</code></td></tr>
				}
			</tbody>
		</table>
		<h4 class="tech-details-title">Never included</h4>
		<table class="data-table">
			<thead>
				<tr>
					<th>Table</th>
					<th>Column</th>
					<th>Reason</th>
				</tr>
			</thead>
			<tbody>
				for _, exclusion := range v.Exclusions {
					<tr><td><code>{ exclusion.Table }</code></td><td>{ emptyDash(exclusion.Column) }</td><td>{ exclusion.Reason }</td></tr>
				}
			</tbody>
		</table>
	</details>
}

// backupEnvVarList names the environment variables a never-included line
// stands for, as "(environment variables such as A, B, C)"; it renders
// nothing without any.
templ backupEnvVarList(names []string) {
	for i, name := range names {
		<span>{ backupEnvVarLead(i) }<code>{ name }</code>{ backupEnvVarTail(i, len(names)) }</span>
	}
}

// backupScheduledSection renders the destination, schedule, "Back up now"
// and run history according to the settings state.
templ backupScheduledSection(v BackupsPageView) {
	<p class="backup-lead">Engram uploads the same archive to one destination, an S3-compatible bucket, a Dropbox folder or a Google Drive folder, on the weekdays and time you choose. Engram never deletes uploaded backups: set expiration with the bucket's lifecycle rules, or clean up the Dropbox or Google Drive folder yourself.</p>
	switch v.Settings {
		case BackupSettingsNotWired:
			@EmptyState("Not Available", "This server has no backup settings store. Download a backup above or run engram cloud backup export on the server.")
		case BackupSettingsUnavailable:
			<div class="data-frame policy-note danger-note">
				<p><strong>Backup settings are temporarily unavailable.</strong> The destination, schedule and run history could not be read. Try again shortly.</p>
			</div>
		default:
			if v.Settings == BackupSettingsKeyMissing {
				<div class="data-frame policy-note">
					<p><strong>Set <code>ENGRAM_CLOUD_BACKUP_KEY</code> to configure scheduled backups.</strong> Destination credentials are stored encrypted with this dedicated key (32 bytes as hex or base64, for example from <code>openssl rand -hex 32</code>) and restart <code>engram cloud serve</code>. Keep the key outside the database and its backups.</p>
				</div>
			} else if !v.CanManage {
				@BackupSettingsAdministrationNotice()
			}
			@backupDestinationBlock(v)
			@backupScheduleBlock(v)
			@backupRunHistory(v)
	}
}

// backupDestinationBlock renders the destination: the status card of the
// stored destination (provider derived from its endpoint host, status pill,
// where the next backup lands, masked access key id, last upload, and the
// remove confirm) with the form collapsed behind "Change destination", or
// the guided setup when none is stored. Forms render only for managed
// admins with the backup key set.
templ backupDestinationBlock(v BackupsPageView) {
	<section class="data-frame backup-destination" aria-labelledby="backup-destination-title">
		<p class="section-kicker" id="backup-destination-title">DESTINATION</p>
		if v.isGDriveDestination() {
			@backupGDriveSummary(v)
		} else if v.isDropboxDestination() {
			@backupDropboxSummary(v)
		} else if v.Destination.Configured {
			@backupDestinationSummary(v)
		} else if v.wizardVisible() {
			<div class="backup-dest-head">
				<div>
					<h4>Set up an off-site destination</h4>
					<p class="muted">No destination is configured. Nothing is uploaded off this server yet; <strong>Download backup</strong> above still works. Setup takes about two minutes: { v.setupReadyNote() }</p>
				</div>
				@StatusBadge("Not configured", "muted")
			</div>
		} else {
			<div class="backup-dest-head">
				<div>
					<h4>Where should Engram send backups?</h4>
					<p class="muted">No destination is configured. Nothing is uploaded off this server yet; <strong>Download backup</strong> above still works.</p>
				</div>
				@StatusBadge("Not configured", "muted")
			</div>
		}
		if n := v.destinationNotice(); n.Kind != "" {
			<div class={ backupAlertClass(n.Kind) } role="status">
				<p>
					if n.Title != "" {
						<strong>{ n.Title }</strong>
					}
					{ n.Message }
				</p>
			</div>
		}
		if v.Destination.Configured && v.DestinationCheck.Result != "" && !v.dropboxCheckVisible() {
			@BackupDestinationCheckResult(v.DestinationCheck)
		}
		if v.settingsFormsVisible() {
			if v.Destination.Configured {
				<details class="backup-change" open?={ v.destinationFormOpen() }>
					<summary>Change destination</summary>
					@backupStoragePicker(v)
					switch v.storageKind() {
						case "dropbox":
							<p class="hint">Saving replaces the current destination. The app secret and refresh token fields start empty; the saved credentials keep working until you save. Saving resets the status to <strong>Not tested</strong>.</p>
							@backupDropboxForm(v)
						case "gdrive":
							<p class="hint">Saving replaces the current destination and needs Connect with Google again. The client secret field starts empty; the saved settings keep working until you save.</p>
							@backupGDriveForm(v)
						default:
							<p class="hint">The same grouped form, pre-filled with the endpoint, region, bucket and prefix. Key fields start empty; the saved key <code>{ v.Destination.AccessKeyIDHint }</code> keeps working until you save. Saving resets the status to <strong>Not tested</strong>.</p>
							@backupDestinationForm(v)
					}
				</details>
			} else {
				@backupStoragePicker(v)
				switch v.storageKind() {
					case "dropbox":
						@backupDropboxForm(v)
					case "gdrive":
						@backupGDriveForm(v)
					default:
						@backupDestinationWizard(v)
				}
			}
		}
	</section>
}

// backupDestinationSummary is the status card of the stored destination.
// It never holds a credential: only the masked access key id hint. The pill
// pairs a word with a shape (Connected, Not tested, Failing, Locked) and
// comes from the newest backup.destination.test audit row since the last
// save. "Test connection" and "Remove destination" render only for managed
// admins with the backup key set; remove is a native <details> confirm
// step, so it works without JavaScript.
templ backupDestinationSummary(v BackupsPageView) {
	<div class="backup-summary">
		<div class="backup-summary-body">
			<h4 class="backup-summary-title">{ v.configuredBackupProvider().Summary } <span class={ "backup-pill " + v.destinationStatus().Class }>{ v.destinationStatus().Label }</span></h4>
			<p class="backup-summary-path">{ v.Destination.Bucket }/{ backupPathPrefix(v.Destination.Prefix) }</p>
			@backupDestinationStatusMeta(v)
		</div>
		if v.settingsFormsVisible() {
			<div class="backup-summary-actions">
				<form method="post" action="/dashboard/admin/backups/destination/test" class="switch-form">
					if v.DestinationTest.Tested() {
						<button type="submit" class="secondary">Test again</button>
					} else {
						<button type="submit">Test connection</button>
					}
				</form>
			</div>
		}
	</div>
	if s := v.destinationStatus(); s.Title != "" {
		<div class="backup-status-line"><p><strong>{ s.Title }</strong> { s.Detail }</p></div>
	}
	<div class="backup-path-strip" role="group" aria-label="Where the next backup lands">
		<p class="backup-path-line">
			<span class="backup-path-seg is-bucket"><small>Bucket</small><span class="backup-path-bucket">{ v.Destination.Bucket + "/" }</span></span>
			if p := backupPathPrefix(v.Destination.Prefix); p != "" {
				<span class="backup-path-seg is-prefix"><small>Prefix</small><span class="backup-path-prefix">{ p }</span></span>
			}
			<span class="backup-path-seg"><small>Object, one per run</small><span class="backup-path-file">{ backupObjectNamePattern }</span></span>
		</p>
	</div>
	<dl class="backup-facts">
		<div><dt>Endpoint</dt><dd><code>{ v.Destination.Endpoint }</code></dd></div>
		<div><dt>Region</dt><dd><code>{ v.Destination.Region }</code></dd></div>
		<div><dt>Access key id</dt><dd><code>{ v.Destination.AccessKeyIDHint }</code></dd></div>
		<div><dt>Saved</dt><dd>{ formatTimeValue(v.Destination.UpdatedAt) }</dd></div>
	</dl>
	@backupRunFacts(v)
	if v.settingsFormsVisible() {
		<details class="backup-remove"><summary class="backup-remove-toggle">Remove destination</summary>
			<form method="post" action="/dashboard/admin/backups/destination/remove" class="backup-confirm">
				<p><strong>Remove this destination?</strong> Engram stops uploading to <strong>{ v.Destination.Bucket }</strong> and deletes the saved keys. Backups already uploaded stay in the bucket. While the schedule stays enabled, each scheduled run is recorded as skipped until you save a new destination.</p>
				<button type="submit" class="backup-danger-fill">Yes, remove destination</button>
			</form>
		</details>
	}
}

// backupRunFacts is the last upload, with the location the uploader
// returned (an S3 object key or a Dropbox path), and the last failure when
// no upload succeeded after it.
templ backupRunFacts(v BackupsPageView) {
	<dl class="backup-facts backup-run-facts">
		<div>
			<dt>Last upload</dt>
			if run := v.LastRuns.LastSuccess; run.ID != 0 {
				<dd>
					@StatusBadge(run.Status, "success")
					{ " " }
					@backupWhen(run.FinishedAt, v.now())
					{ " · " + formatBackupSize(run.SizeBytes) }
					<span class="backup-run-key"><code>{ run.ObjectKey }</code></span>
				</dd>
			} else {
				<dd>None yet</dd>
			}
		</div>
		if v.lastFailureVisible() {
			<div>
				<dt>Last failure</dt>
				<dd>
					@StatusBadge(v.LastRuns.LastFailure.Status, "danger")
					{ " " }
					@backupWhen(v.LastRuns.LastFailure.FinishedAt, v.now())
					<span class="backup-run-error">{ v.LastRuns.LastFailure.ErrorMessage }</span>
				</dd>
			</div>
		}
	</dl>
}

// backupDropboxSummary is the status card of a stored Dropbox destination:
// kind, folder, masked app key, the status pill of the latest test, where
// the next backup lands and the last upload's Dropbox path. It never holds a
// secret or the full app key. Test and remove use the same routes as any
// destination.
templ backupDropboxSummary(v BackupsPageView) {
	<div class="backup-summary">
		<div class="backup-summary-body">
			<h4 class="backup-summary-title">Dropbox <span class={ "backup-pill " + v.destinationStatus().Class }>{ v.destinationStatus().Label }</span></h4>
			<p class="backup-summary-path">{ backupDropboxFolderPrefix(v.Destination.Dropbox.FolderPath) }</p>
			@backupDestinationStatusMeta(v)
		</div>
		if v.settingsFormsVisible() {
			<div class="backup-summary-actions">
				<form method="post" action="/dashboard/admin/backups/destination/test" class="switch-form">
					if v.DestinationTest.Tested() {
						<button type="submit" class="secondary">Test again</button>
					} else {
						<button type="submit">Test connection</button>
					}
				</form>
			</div>
		}
	</div>
	if s := v.destinationStatus(); s.Title != "" {
		<div class="backup-status-line"><p><strong>{ s.Title }</strong> { s.Detail }</p></div>
	}
	<div class="backup-path-strip" role="group" aria-label="Where the next backup lands">
		<p class="backup-path-line">
			<span class="backup-path-seg is-bucket"><small>Folder</small><span class="backup-path-bucket">{ backupDropboxFolderPrefix(v.Destination.Dropbox.FolderPath) }</span></span>
			<span class="backup-path-seg"><small>File, one per run</small><span class="backup-path-file">{ backupObjectNamePattern }</span></span>
		</p>
	</div>
	<dl class="backup-facts">
		<div><dt>Storage</dt><dd>Dropbox</dd></div>
		<div><dt>App key</dt><dd><code>{ v.Destination.AccessKeyIDHint }</code></dd></div>
		<div><dt>Saved</dt><dd>{ formatTimeValue(v.Destination.UpdatedAt) }</dd></div>
	</dl>
	@backupRunFacts(v)
	if v.settingsFormsVisible() {
		<details class="backup-remove"><summary class="backup-remove-toggle">Remove destination</summary>
			<form method="post" action="/dashboard/admin/backups/destination/remove" class="backup-confirm">
				<p><strong>Remove this destination?</strong> Engram stops uploading to <strong>{ v.Destination.Dropbox.FolderPath }</strong> and deletes the saved app secret and refresh token. Backups already uploaded stay in Dropbox. While the schedule stays enabled, each scheduled run is recorded as skipped until you save a new destination.</p>
				<button type="submit" class="backup-danger-fill">Yes, remove destination</button>
			</form>
		</details>
	}
}

// backupStoragePicker chooses the kind of destination whose form renders:
// a segmented row of plain links to ?kind=, so it works without JavaScript
// and adds no form to the page. The current kind is marked with
// aria-current. Nothing is stored until a destination form is saved.
templ backupStoragePicker(v BackupsPageView) {
	<div class="backup-storage-pick">
		<p class="backup-storage-label" id="backup-storage-label">Storage</p>
		<nav class="backup-storage-options" aria-labelledby="backup-storage-label">
			for _, o := range backupStorageOptions {
				if v.storageKind() == o.Kind {
					<a href={ templ.SafeURL(backupStorageURL(o.Kind)) } data-storage-kind={ o.Kind } aria-current="true" class="active">{ o.Name }</a>
				} else {
					<a href={ templ.SafeURL(backupStorageURL(o.Kind)) } data-storage-kind={ o.Kind }>{ o.Name }</a>
				}
			}
		</nav>
		<p class="hint">Where Engram sends the archives. One destination at a time: saving another kind replaces the current one.</p>
	</div>
}

// backupGDriveSummary is the status card of a stored Google Drive
// destination: folder, masked client id, authorization, the status pill
// (Not connected until Connect with Google completes, then the latest test),
// where the next backup lands and the last upload. It never holds the client
// secret, the refresh token or the full client id. Connect with Google
// renders only with ENGRAM_CLOUD_PUBLIC_URL; Test connection only once
// authorized.
templ backupGDriveSummary(v BackupsPageView) {
	<div class="backup-summary">
		<div class="backup-summary-body">
			<h4 class="backup-summary-title">Google Drive <span class={ "backup-pill " + v.destinationStatus().Class }>{ v.destinationStatus().Label }</span></h4>
			<p class="backup-summary-path">{ backupGDriveFolderPrefix(v.Destination.GDrive.FolderName) }</p>
			@backupDestinationStatusMeta(v)
		</div>
		if v.settingsFormsVisible() {
			<div class="backup-summary-actions">
				if v.Destination.GDrive.Authorized {
					<form method="post" action="/dashboard/admin/backups/destination/test" class="switch-form">
						if v.DestinationTest.Tested() {
							<button type="submit" class="secondary">Test again</button>
						} else {
							<button type="submit">Test connection</button>
						}
					</form>
				}
				if v.gdriveConnectVisible() {
					<form method="post" action="/dashboard/admin/backups/gdrive/connect" class="switch-form">
						if v.Destination.GDrive.Authorized {
							<button type="submit" class="secondary">Reconnect with Google</button>
						} else {
							<button type="submit">Connect with Google</button>
						}
					</form>
				}
			</div>
		}
	</div>
	if v.settingsFormsVisible() && v.GDriveRedirectURI == "" {
		@backupGDrivePublicURLNote()
	}
	if s := v.destinationStatus(); s.Title != "" {
		<div class="backup-status-line"><p><strong>{ s.Title }</strong> { s.Detail }</p></div>
	}
	<div class="backup-path-strip" role="group" aria-label="Where the next backup lands">
		<p class="backup-path-line">
			<span class="backup-path-seg is-bucket"><small>Folder in My Drive</small><span class="backup-path-bucket">{ backupGDriveFolderPrefix(v.Destination.GDrive.FolderName) }</span></span>
			<span class="backup-path-seg"><small>File, one per run</small><span class="backup-path-file">{ backupObjectNamePattern }</span></span>
		</p>
	</div>
	<dl class="backup-facts">
		<div><dt>Storage</dt><dd>Google Drive</dd></div>
		<div><dt>Client ID</dt><dd><code>{ v.Destination.AccessKeyIDHint }</code></dd></div>
		<div>
			<dt>Authorization</dt>
			if v.Destination.GDrive.Authorized {
				<dd>Connected</dd>
			} else {
				<dd>Pending</dd>
			}
		</div>
		<div><dt>Saved</dt><dd>{ formatTimeValue(v.Destination.UpdatedAt) }</dd></div>
	</dl>
	@backupRunFacts(v)
	if v.settingsFormsVisible() {
		<details class="backup-remove"><summary class="backup-remove-toggle">Remove destination</summary>
			<form method="post" action="/dashboard/admin/backups/destination/remove" class="backup-confirm">
				<p><strong>Remove this destination?</strong> Engram stops uploading to <strong>{ v.Destination.GDrive.FolderName }</strong> and deletes the saved client secret and Google authorization. Backups already uploaded stay in Google Drive. To revoke Engram's access too, remove it at <a href="https://myaccount.google.com/permissions" rel="noopener noreferrer" target="_blank">myaccount.google.com/permissions</a>. While the schedule stays enabled, each scheduled run is recorded as skipped until you save a new destination.</p>
				<button type="submit" class="backup-danger-fill">Yes, remove destination</button>
			</form>
		</details>
	}
}

// backupGDrivePublicURLNote explains why Connect with Google is missing:
// the redirect URI is built only from ENGRAM_CLOUD_PUBLIC_URL.
templ backupGDrivePublicURLNote() {
	<div class="backup-note" role="note">
		<p><strong>Set <code>ENGRAM_CLOUD_PUBLIC_URL</code> to connect Google Drive.</strong> Google sends the browser back to this dashboard after you allow access, so Engram needs the dashboard's public https address (for example <code>https://engram.example.com</code>) to build the redirect URI. Set it and restart <code>engram cloud serve</code>.</p>
	</div>
}

// backupGDriveForm is the Google Drive destination form: a plain POST to the
// save route with kind=gdrive. Saving stores the OAuth client pending
// authorization; Connect with Google on the status card authorizes it, so
// there is no check before saving. The client secret is required on every
// save and always renders empty.
templ backupGDriveForm(v BackupsPageView) {
	<form method="post" action="/dashboard/admin/backups/destination" class="backup-provider-form backup-gdrive-form" autocomplete="off">
		<input type="hidden" name="kind" value="gdrive"/>
		if v.gdriveSaveRefused() {
			<div class="alert alert-danger" role="alert">
				<p>
					<strong>Destination not saved.</strong>
					if reason := v.gdriveErrorUnplaced(); reason != "" {
						{ reason + "." }
					} else {
						Fix the field marked below.
					}
					Your client secret was not stored: paste it again.
				</p>
			</div>
		}
		<div class="backup-form-body">
			<div class="backup-groups">
				<fieldset class="backup-group">
					<legend class="backup-group-title"><span class="backup-step" aria-hidden="true">1</span>Google OAuth client</legend>
					<p class="hint backup-group-hint">A Web application client of your Google Cloud project; the guide below shows how to create one.</p>
					<div class="backup-group-fields even">
						<div class="backup-field">
							<label for="backup-gdrive-client-id">Client ID</label>
							<input type="text" id="backup-gdrive-client-id" name="client_id" value={ v.gdriveFormValue("client_id") } autocomplete="off" spellcheck="false" placeholder="….apps.googleusercontent.com" class="mono-input" required { v.gdriveFieldAttrs("client_id", "backup-gdrive-client-id", false)... }/>
							@backupFieldError(v.gdriveFieldError("client_id"), "backup-gdrive-client-id")
						</div>
						<div class="backup-field">
							<label for="backup-gdrive-client-secret">Client secret</label>
							<input type="password" id="backup-gdrive-client-secret" name="client_secret" value="" autocomplete="new-password" placeholder="From the OAuth client's page" required { v.gdriveFieldAttrs("client_secret", "backup-gdrive-client-secret", false)... }/>
							@backupFieldError(v.gdriveFieldError("client_secret"), "backup-gdrive-client-secret")
						</div>
					</div>
				</fieldset>
				<fieldset class="backup-group">
					<legend class="backup-group-title"><span class="backup-step" aria-hidden="true">2</span>Location</legend>
					<p class="hint backup-group-hint">Where the archives land.</p>
					<div class="backup-group-fields">
						<div class="backup-field">
							<label for="backup-gdrive-folder">Folder</label>
							<input type="text" id="backup-gdrive-folder" name="folder" value={ v.gdriveFormValue("folder") } placeholder="Engram backups" spellcheck="false" required { v.gdriveFieldAttrs("folder", "backup-gdrive-folder", true)... }/>
							@backupFieldError(v.gdriveFieldError("folder"), "backup-gdrive-folder")
							<span class="hint" id="backup-gdrive-folder-hint">A folder in My Drive, created by Engram on the first upload. With the <code>drive.file</code> scope Engram only sees the files and folders it created, never the rest of your Drive.</span>
						</div>
					</div>
				</fieldset>
				<fieldset class="backup-group">
					<legend class="backup-group-title"><span class="backup-step" aria-hidden="true">3</span>Authorization</legend>
					<p class="hint backup-group-hint">After saving, press <strong>Connect with Google</strong> on the status card and allow access with the account that should hold the backups.</p>
					if v.GDriveRedirectURI != "" {
						<div class="backup-redirect-uri">
							<p class="backup-storage-label">Authorized redirect URI</p>
							<p><code>{ v.GDriveRedirectURI }</code></p>
							<p class="hint">Add this exact URI to the OAuth client in Google Cloud.</p>
						</div>
					} else {
						@backupGDrivePublicURLNote()
					}
				</fieldset>
			</div>
			<aside class="backup-aside" aria-label="What you are saving">
				<div class="backup-path-preview">
					<p class="section-kicker">Backups will be saved as</p>
					<p class="backup-path"><span class="backup-path-bucket">{ backupGDriveFolderPrefix(v.gdriveFormValue("folder")) }</span><span class="backup-path-file">{ "engram-cloud-backup-<UTC timestamp>-run<id>.tar.gz" }</span></p>
					<p class="hint">One file per run: UTC time plus run number. Engram never deletes them.</p>
				</div>
				<div class="backup-why-keys">
					<h5><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="3" y="7" width="10" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M5.5 7V5a2.5 2.5 0 015 0v2" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>Why paste it again?</h5>
					<p>Engram encrypts the client secret and the Google authorization together with this exact client ID and folder, and never shows them again, not even to admins.</p>
					<p>So every save needs the secret and a new Connect with Google, even if you only changed the folder.</p>
				</div>
			</aside>
		</div>
		@backupGDriveHelp(v)
		<div class="backup-submit-row">
			<p class="muted">Saving stores the client; it does not contact Google. Then press <strong>Connect with Google</strong> to authorize Engram.</p>
			<div class="backup-dropbox-actions">
				<button type="submit">Save Google Drive settings</button>
			</div>
		</div>
	</form>
}

// backupGDriveHelp explains, collapsed, how to create the Google OAuth
// client, including the 7-day refresh token expiry of apps left in Testing.
templ backupGDriveHelp(v BackupsPageView) {
	<details class="backup-help">
		<summary>How to create a Google OAuth client</summary>
		<ol class="backup-help-steps">
			<li>Open the <a href="https://console.cloud.google.com/" rel="noopener noreferrer" target="_blank">Google Cloud console</a> and create or pick a project.</li>
			<li>In <strong>APIs &amp; Services → Library</strong>, enable the <strong>Google Drive API</strong>.</li>
			<li>Configure the <strong>OAuth consent screen</strong> (Google Auth Platform): choose <strong>External</strong> (any Google account, such as Gmail) or <strong>Internal</strong> (only accounts of your Google Workspace organization). With External, add yourself as a <strong>test user</strong> under <strong>Audience</strong>. Under <strong>Data access</strong>, add the <code>drive.file</code> scope (<code>https://www.googleapis.com/auth/drive.file</code>).</li>
			<li><strong>Important:</strong> while an External app's publishing status is <strong>Testing</strong>, Google expires its refresh tokens after 7 days and scheduled backups stop. Under <strong>Audience</strong>, press <strong>Publish app</strong> to move it to <strong>In production</strong>. <code>drive.file</code> is a recommended, non-sensitive scope, so publishing does not need Google's sensitive-scope verification. Internal apps have no Testing status.</li>
			<li>
				In <strong>Clients</strong> (or <strong>Credentials → Create credentials → OAuth client ID</strong>), create a client of type <strong>Web application</strong>. Under <strong>Authorized redirect URIs</strong>, add exactly:
				if v.GDriveRedirectURI != "" {
					<pre class="backup-help-code"><code>{ v.GDriveRedirectURI }</code></pre>
				} else {
					the URI this form shows once <code>ENGRAM_CLOUD_PUBLIC_URL</code> is set.
				}
			</li>
			<li>Copy the <strong>Client ID</strong> and the <strong>Client secret</strong> into this form and save, then press <strong>Connect with Google</strong> and sign in with the account that should hold the backups. Engram asks only for <code>drive.file</code>.</li>
		</ol>
	</details>
}

// backupDropboxForm is the Dropbox destination form: a plain POST to the
// save route with kind=dropbox. "Test connection" posts the same fields to
// the check route through formaction, so checking before saving works
// without JavaScript; Save is the first submit button, so Enter saves. The
// app secret and the refresh token are required on every save and always
// render empty.
templ backupDropboxForm(v BackupsPageView) {
	<form method="post" action="/dashboard/admin/backups/destination" class="backup-provider-form backup-dropbox-form" autocomplete="off">
		<input type="hidden" name="kind" value="dropbox"/>
		if v.dropboxSaveRefused() {
			<div class="alert alert-danger" role="alert">
				<p>
					<strong>Destination not saved.</strong>
					if reason := v.dropboxErrorUnplaced(); reason != "" {
						{ reason + "." }
					} else {
						Fix the field marked below.
					}
					Your app secret and refresh token were not stored: paste them again.
				</p>
			</div>
		}
		if v.dropboxCheckVisible() {
			@BackupDestinationCheckResult(v.DestinationCheck)
		}
		<div class="backup-form-body">
			<div class="backup-groups">
				<fieldset class="backup-group">
					<legend class="backup-group-title"><span class="backup-step" aria-hidden="true">1</span>Dropbox app</legend>
					<p class="hint backup-group-hint">The app Engram uses to reach your Dropbox.</p>
					<div class="backup-group-fields even">
						<div class="backup-field">
							<label for="backup-dropbox-app-key">App key</label>
							<input type="text" id="backup-dropbox-app-key" name="app_key" value={ v.dropboxFormValue("app_key") } autocomplete="off" spellcheck="false" placeholder="From the app's Settings tab" class="mono-input" required { v.dropboxFieldAttrs("app_key", "backup-dropbox-app-key", false)... }/>
							@backupFieldError(v.dropboxFieldError("app_key"), "backup-dropbox-app-key")
						</div>
						<div class="backup-field">
							<label for="backup-dropbox-app-secret">App secret</label>
							<input type="password" id="backup-dropbox-app-secret" name="app_secret" value="" autocomplete="new-password" placeholder="From the app's Settings tab" required { v.dropboxFieldAttrs("app_secret", "backup-dropbox-app-secret", false)... }/>
							@backupFieldError(v.dropboxFieldError("app_secret"), "backup-dropbox-app-secret")
						</div>
					</div>
				</fieldset>
				<fieldset class="backup-group">
					<legend class="backup-group-title"><span class="backup-step" aria-hidden="true">2</span>Authorization</legend>
					<p class="hint backup-group-hint">A long-lived refresh token; Engram trades it for short-lived access tokens.</p>
					<div class="backup-group-fields">
						<div class="backup-field">
							<label for="backup-dropbox-refresh-token">Refresh token</label>
							<input type="password" id="backup-dropbox-refresh-token" name="refresh_token" value="" autocomplete="new-password" placeholder="Paste the refresh_token value" required { v.dropboxFieldAttrs("refresh_token", "backup-dropbox-refresh-token", false)... }/>
							@backupFieldError(v.dropboxFieldError("refresh_token"), "backup-dropbox-refresh-token")
						</div>
					</div>
				</fieldset>
				<fieldset class="backup-group">
					<legend class="backup-group-title"><span class="backup-step" aria-hidden="true">3</span>Location</legend>
					<p class="hint backup-group-hint">Where the archives land.</p>
					<div class="backup-group-fields">
						<div class="backup-field">
							<label for="backup-dropbox-folder">Folder</label>
							<input type="text" id="backup-dropbox-folder" name="folder_path" value={ v.dropboxFormValue("folder_path") } placeholder="/Engram backups" class="mono-input" spellcheck="false" required { v.dropboxFieldAttrs("folder_path", "backup-dropbox-folder", true)... }/>
							@backupFieldError(v.dropboxFieldError("folder_path"), "backup-dropbox-folder")
							<span class="hint" id="backup-dropbox-folder-hint">Starts with <code>/</code>. With an App folder app it lives inside <code>Apps/&lt;app name&gt;</code>. Engram creates it on the first upload.</span>
						</div>
					</div>
				</fieldset>
			</div>
			<aside class="backup-aside" aria-label="What you are saving">
				<div class="backup-path-preview">
					<p class="section-kicker">Backups will be saved as</p>
					<p class="backup-path"><span class="backup-path-bucket">{ backupDropboxFolderPrefix(v.dropboxFormValue("folder_path")) }</span><span class="backup-path-file">{ "engram-cloud-backup-<UTC timestamp>-run<id>.tar.gz" }</span></p>
					<p class="hint">One file per run: UTC time plus run number, so runs never overwrite each other. Engram never deletes them.</p>
				</div>
				<div class="backup-why-keys">
					<h5><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="3" y="7" width="10" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M5.5 7V5a2.5 2.5 0 015 0v2" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>Why paste them again?</h5>
					<p>Engram encrypts the app secret and the refresh token together with this exact app key and folder, and never shows them again, not even to admins.</p>
					<p>So every save needs both, even if you only changed the folder. Keep them in your password manager.</p>
				</div>
			</aside>
		</div>
		@backupDropboxHelp()
		<div class="backup-submit-row">
			<p class="muted">Saving stores the destination; it does not upload anything. <strong>Test connection</strong> checks these values with Dropbox and stores nothing.</p>
			<div class="backup-dropbox-actions">
				<button type="submit">Save destination</button>
				<button type="submit" class="secondary" formaction="/dashboard/admin/backups/destination/check">Test connection</button>
			</div>
		</div>
	</form>
}

// backupDropboxHelp explains, collapsed, how to create the Dropbox app and
// obtain a refresh token with the offline authorization code flow.
templ backupDropboxHelp() {
	<details class="backup-help">
		<summary>How to get these values</summary>
		<ol class="backup-help-steps">
			<li>Open the <a href="https://www.dropbox.com/developers/apps" rel="noopener noreferrer" target="_blank">Dropbox App Console</a> and choose <strong>Create app</strong>.</li>
			<li>Choose <strong>Scoped access</strong>, then <strong>App folder</strong> (recommended: the app only sees <code>Apps/&lt;app name&gt;</code>) or <strong>Full Dropbox</strong>.</li>
			<li>On the <strong>Permissions</strong> tab enable <code>files.content.write</code> and <code>files.metadata.read</code>, then press <strong>Submit</strong>. Do this before you authorize: a token keeps the permissions it was issued with.</li>
			<li>On the <strong>Settings</strong> tab copy the <strong>App key</strong> and the <strong>App secret</strong>.</li>
			<li>
				Signed in as the Dropbox account that should hold the backups, open this URL with your app key in place of <code>APP_KEY</code>, press <strong>Allow</strong> and copy the authorization code:
				<pre class="backup-help-code"><code>{ backupDropboxAuthorizeURL }</code></pre>
			</li>
			<li>
				Within a few minutes, trade the code for a refresh token:
				<pre class="backup-help-code"><code>{ backupDropboxTokenExchange }</code></pre>
				Paste the <code>refresh_token</code> value of the answer, not <code>access_token</code>, which expires within hours.
			</li>
		</ol>
	</details>
}

// backupDestinationStatusMeta is the line under the status pill: when and
// by whom the destination was last tested, or what to do next.
templ backupDestinationStatusMeta(v BackupsPageView) {
	<p class="backup-status-meta">
		switch {
			case v.Settings == BackupSettingsKeyMissing:
				The saved keys cannot be used or tested until <code>ENGRAM_CLOUD_BACKUP_KEY</code> is set.
			case v.gdrivePending():
				Not connected yet: press <strong>Connect with Google</strong> and allow access with the account that should hold the backups. Scheduled backups are recorded as skipped until then.
			case !v.DestinationTest.Tested():
				{ v.untestedNote() }
			default:
				{ "Last tested " }
				@backupWhen(v.DestinationTest.OccurredAt, v.now())
				if v.DestinationTest.ActorName != "" {
					{ " by " + v.DestinationTest.ActorName }
				}
				if v.DestinationTest.Succeeded {
					{ v.testedNote() }
				}
		}
	</p>
}

// backupWhen renders a time as relative text with the absolute UTC time.
templ backupWhen(t time.Time, now time.Time) {
	<time datetime={ backupTimeAttr(t) }>{ backupRelativeTime(t, now) }</time> <span class="backup-when-utc">{ backupUTCLabel(t) }</span>
}

// backupDestinationForm is a plain POST form: the provider select only
// switches the hint line (CSS where :has() is supported) and is never
// stored; the server reads endpoint, region, bucket, prefix and both
// credentials.
templ backupDestinationForm(v BackupsPageView) {
	<form method="post" action="/dashboard/admin/backups/destination" class="backup-provider-form" autocomplete="off">
		if v.destinationSaveRefused() {
			<div class="alert alert-danger" role="alert">
				<p>
					<strong>Destination not saved.</strong>
					if reason := v.destinationErrorUnplaced(); reason != "" {
						{ reason + "." }
					} else {
						Fix the field marked below.
					}
					Your keys were not stored: paste both again.
				</p>
			</div>
		}
		<div class="backup-form-body">
			<div class="backup-groups">
				<fieldset class="backup-group">
					<legend class="backup-group-title"><span class="backup-step" aria-hidden="true">1</span>Connection</legend>
					<p class="hint backup-group-hint">How Engram reaches the storage service.</p>
					<div class="backup-group-fields">
						@backupProviderPicker(v)
						<div class="backup-field">
							<label for="backup-endpoint">Endpoint</label>
							<input type="text" id="backup-endpoint" name="endpoint" value={ v.destinationFormValue("endpoint") } placeholder={ v.pickedBackupProvider().EndpointPlaceholder } class="mono-input" spellcheck="false" required { v.destinationFieldAttrs("endpoint", "backup-endpoint", true)... }/>
							@backupFieldError(v.destinationFieldError("endpoint"), "backup-endpoint")
							<span class="hint" id="backup-endpoint-hint">Origin only, starting with <code>https://</code>; plain <code>http://</code> only for localhost and loopback addresses.</span>
						</div>
						<div class="backup-field">
							<label for="backup-region">Region</label>
							<input type="text" id="backup-region" name="region" value={ v.destinationFormValue("region") } placeholder={ v.pickedBackupProvider().RegionPlaceholder } list="backup-region-suggestions" class="mono-input" spellcheck="false" required { v.destinationFieldAttrs("region", "backup-region", true)... }/>
							<datalist id="backup-region-suggestions">
								for _, region := range backupRegionSuggestions {
									<option value={ region }></option>
								}
							</datalist>
							@backupFieldError(v.destinationFieldError("region"), "backup-region")
							<span class="hint" id="backup-region-hint">Cloudflare R2 uses <code>auto</code>; other providers use the bucket's region.</span>
						</div>
					</div>
				</fieldset>
				<fieldset class="backup-group">
					<legend class="backup-group-title"><span class="backup-step" aria-hidden="true">2</span>Location</legend>
					<p class="hint backup-group-hint">Where the archives land.</p>
					<div class="backup-group-fields even">
						<div class="backup-field">
							<label for="backup-bucket">Bucket</label>
							<input type="text" id="backup-bucket" name="bucket" value={ v.destinationFormValue("bucket") } placeholder="engram-backups" class="mono-input" spellcheck="false" required { v.destinationFieldAttrs("bucket", "backup-bucket", true)... }/>
							@backupFieldError(v.destinationFieldError("bucket"), "backup-bucket")
							<span class="hint" id="backup-bucket-hint">3–63 lowercase letters, digits, dots or hyphens.</span>
						</div>
						<div class="backup-field">
							<label for="backup-prefix">Prefix <span class="muted">(optional)</span></label>
							<input type="text" id="backup-prefix" name="prefix" value={ v.destinationFormValue("prefix") } placeholder="engram/prod/" class="mono-input" spellcheck="false" { v.destinationFieldAttrs("prefix", "backup-prefix", true)... }/>
							@backupFieldError(v.destinationFieldError("prefix"), "backup-prefix")
							<span class="hint" id="backup-prefix-hint">A folder inside the bucket. No leading <code>/</code>.</span>
						</div>
					</div>
				</fieldset>
				<fieldset class="backup-group">
					<legend class="backup-group-title"><span class="backup-step" aria-hidden="true">3</span>Credentials</legend>
					<p class="hint backup-group-hint">Paste both, every time you save.</p>
					<div class="backup-group-fields even">
						<div class="backup-field">
							<label for="backup-access-key-id">Access key id</label>
							<input type="text" id="backup-access-key-id" name="access_key_id" value="" autocomplete="off" spellcheck="false" placeholder="Paste from your provider" class="mono-input" required { v.destinationFieldAttrs("access_key_id", "backup-access-key-id", false)... }/>
							@backupFieldError(v.destinationFieldError("access_key_id"), "backup-access-key-id")
						</div>
						<div class="backup-field">
							<label for="backup-secret-access-key">Secret access key</label>
							<input type="password" id="backup-secret-access-key" name="secret_access_key" value="" autocomplete="new-password" placeholder="Paste from your provider" required { v.destinationFieldAttrs("secret_access_key", "backup-secret-access-key", false)... }/>
							@backupFieldError(v.destinationFieldError("secret_access_key"), "backup-secret-access-key")
						</div>
					</div>
				</fieldset>
			</div>
			<aside class="backup-aside" aria-label="What you are saving">
				<div class="backup-path-preview">
					<p class="section-kicker">Backups will be saved as</p>
					<p class="backup-path"><span class="backup-path-bucket">{ backupPathBucket(v.destinationFormValue("bucket")) }</span>/<span class="backup-path-prefix">{ backupPathPrefix(v.destinationFormValue("prefix")) }</span><span class="backup-path-file">{ "engram-cloud-backup-<UTC timestamp>-run<id>.tar.gz" }</span></p>
					<p class="hint">One object per run: UTC time plus run number, so runs never overwrite each other.</p>
				</div>
				<div class="backup-why-keys">
					<h5><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="3" y="7" width="10" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M5.5 7V5a2.5 2.5 0 015 0v2" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>Why paste both keys again?</h5>
					<p>Engram encrypts your keys together with this exact endpoint, region, bucket and prefix, and never shows them again, not even to admins.</p>
					<p>So every save needs both keys, even if you only changed the prefix. Keep them in your password manager.</p>
				</div>
			</aside>
		</div>
		<div class="backup-submit-row">
			<p class="muted">Saving stores the destination; it does not upload anything. Use <strong>Test connection</strong> right after to check the keys.</p>
			<button type="submit">Save destination</button>
		</div>
	</form>
}

// backupDestinationWizard is the first-time guided setup: Provider,
// Connection, Credentials, Test & save, with a running summary. It is one
// plain POST form to the save route with a single "Save destination"
// submit, so without JavaScript the four steps render as four sections.
// backups-wizard.js (loaded only here) shows one step at a time, checks the
// required fields of each step, and reveals Back, Next and "Test
// connection", which asks the check route about the submitted fields
// without saving them. The script element sits in this component so no
// other page loads it.
templ backupDestinationWizard(v BackupsPageView) {
	<form method="post" action="/dashboard/admin/backups/destination" class="backup-wizard" autocomplete="off" data-backup-wizard data-wizard-start={ v.wizardStartStep() }>
		if v.destinationSaveRefused() {
			<div class="alert alert-danger" role="alert">
				<p>
					<strong>Destination not saved.</strong>
					if reason := v.destinationErrorUnplaced(); reason != "" {
						{ reason + "." }
					} else {
						Fix the field marked below.
					}
					Your keys were not stored: paste both again.
				</p>
			</div>
		}
		<ol class="backup-stepper" aria-label="Setup progress">
			for _, step := range backupWizardSteps {
				<li data-wizard-stepper-item={ step.Number }>
					<a href={ templ.SafeURL("#backup-wizard-step-" + step.Number) } data-wizard-goto={ step.Number }>
						<span class="backup-stepper-dot" aria-hidden="true">{ step.Number }</span>
						<span class="backup-stepper-name">{ step.Name }</span>
						<span class="backup-stepper-sub" data-wizard-stepper-sub={ step.Number }>{ step.Sub }</span>
					</a>
				</li>
			}
		</ol>
		<div class="backup-wizard-body">
			<div class="backup-wizard-steps">
				<fieldset class="backup-step-panel" id="backup-wizard-step-1" data-wizard-step="1">
					<legend><h5 class="backup-step-title" id="backup-wizard-step-1-title" tabindex="-1">Step 1 of 4 · Provider</h5></legend>
					<p class="hint">Where should the archives go? The choice fills in the endpoint and region hints; it is not stored.</p>
					@backupProviderPicker(v)
					<div class="backup-step-nav">
						<span class="muted">You can also skip this and fill in the fields directly.</span>
						<button type="button" data-wizard-next hidden>Continue to connection →</button>
					</div>
				</fieldset>
				<fieldset class="backup-step-panel" id="backup-wizard-step-2" data-wizard-step="2">
					<legend><h5 class="backup-step-title" id="backup-wizard-step-2-title" tabindex="-1">Step 2 of 4 · Connection</h5></legend>
					<p class="hint">How Engram reaches the storage service, and where in it the archives land.</p>
					<div class="backup-wizard-fields is-wide">
						<div class="backup-field">
							<label for="backup-endpoint">Endpoint</label>
							<input type="text" id="backup-endpoint" name="endpoint" value={ v.destinationFormValue("endpoint") } placeholder={ v.pickedBackupProvider().EndpointPlaceholder } class="mono-input" spellcheck="false" required { v.destinationFieldAttrs("endpoint", "backup-endpoint", true)... }/>
							@backupFieldError(v.destinationFieldError("endpoint"), "backup-endpoint")
							<span class="hint" id="backup-endpoint-hint">Origin only, starting with <code>https://</code>; plain <code>http://</code> only for localhost and loopback addresses.</span>
						</div>
						<div class="backup-field">
							<label for="backup-region">Region</label>
							<input type="text" id="backup-region" name="region" value={ v.destinationFormValue("region") } placeholder={ v.pickedBackupProvider().RegionPlaceholder } list="backup-region-suggestions" class="mono-input" spellcheck="false" required { v.destinationFieldAttrs("region", "backup-region", true)... }/>
							<datalist id="backup-region-suggestions">
								for _, region := range backupRegionSuggestions {
									<option value={ region }></option>
								}
							</datalist>
							@backupFieldError(v.destinationFieldError("region"), "backup-region")
							<span class="hint" id="backup-region-hint">Cloudflare R2 uses <code>auto</code>; other providers use the bucket's region.</span>
						</div>
					</div>
					<div class="backup-wizard-fields">
						<div class="backup-field">
							<label for="backup-bucket">Bucket</label>
							<input type="text" id="backup-bucket" name="bucket" value={ v.destinationFormValue("bucket") } placeholder="engram-backups" class="mono-input" spellcheck="false" required { v.destinationFieldAttrs("bucket", "backup-bucket", true)... }/>
							@backupFieldError(v.destinationFieldError("bucket"), "backup-bucket")
							<span class="hint" id="backup-bucket-hint">3–63 lowercase letters, digits, dots or hyphens.</span>
						</div>
						<div class="backup-field">
							<label for="backup-prefix">Prefix <span class="muted">(optional)</span></label>
							<input type="text" id="backup-prefix" name="prefix" value={ v.destinationFormValue("prefix") } placeholder="engram/prod/" class="mono-input" spellcheck="false" { v.destinationFieldAttrs("prefix", "backup-prefix", true)... }/>
							@backupFieldError(v.destinationFieldError("prefix"), "backup-prefix")
							<span class="hint" id="backup-prefix-hint">A folder inside the bucket. No leading <code>/</code>.</span>
						</div>
					</div>
					<div class="backup-path-preview">
						<p class="section-kicker">Backups will be saved as</p>
						<p class="backup-path"><span class="backup-path-bucket">{ backupPathBucket(v.destinationFormValue("bucket")) }</span>/<span class="backup-path-prefix">{ backupPathPrefix(v.destinationFormValue("prefix")) }</span><span class="backup-path-file">{ "engram-cloud-backup-<UTC timestamp>-run<id>.tar.gz" }</span></p>
						<p class="hint">One object per run: UTC time plus run number, so runs never overwrite each other.</p>
					</div>
					<div class="backup-step-nav">
						<button type="button" class="secondary" data-wizard-back hidden>← Back</button>
						<button type="button" data-wizard-next hidden>Continue to credentials →</button>
					</div>
				</fieldset>
				<fieldset class="backup-step-panel" id="backup-wizard-step-3" data-wizard-step="3">
					<legend><h5 class="backup-step-title" id="backup-wizard-step-3-title" tabindex="-1">Step 3 of 4 · Credentials</h5></legend>
					<p class="hint">An access key pair from your provider that can list and write objects in this bucket.</p>
					<div class="backup-keys-callout">
						<span class="backup-keys-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="3" y="7" width="10" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M5.5 7V5a2.5 2.5 0 015 0v2" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg></span>
						<div>
							<p><strong>Your keys are sealed, then forgotten by the screen.</strong> Engram encrypts them with this server's backup key, bound to this exact endpoint, region, bucket and prefix. Nobody can view them again, not even admins.</p>
							<p>That is why every save asks for both keys, even for a small change. Keep a copy in your password manager.</p>
						</div>
					</div>
					<div class="backup-wizard-fields">
						<div class="backup-field">
							<label for="backup-access-key-id">Access key id</label>
							<input type="text" id="backup-access-key-id" name="access_key_id" value="" autocomplete="off" spellcheck="false" placeholder="Paste from your provider" class="mono-input" required { v.destinationFieldAttrs("access_key_id", "backup-access-key-id", false)... }/>
							@backupFieldError(v.destinationFieldError("access_key_id"), "backup-access-key-id")
						</div>
						<div class="backup-field">
							<label for="backup-secret-access-key">Secret access key</label>
							<input type="password" id="backup-secret-access-key" name="secret_access_key" value="" autocomplete="new-password" placeholder="Paste from your provider" required { v.destinationFieldAttrs("secret_access_key", "backup-secret-access-key", false)... }/>
							@backupFieldError(v.destinationFieldError("secret_access_key"), "backup-secret-access-key")
						</div>
					</div>
					<div class="backup-step-nav">
						<button type="button" class="secondary" data-wizard-back hidden>← Back</button>
						<button type="button" data-wizard-next hidden>Review &amp; test →</button>
					</div>
				</fieldset>
				<fieldset class="backup-step-panel" id="backup-wizard-step-4" data-wizard-step="4">
					<legend><h5 class="backup-step-title" id="backup-wizard-step-4-title" tabindex="-1">Step 4 of 4 · Test &amp; save</h5></legend>
					<p class="hint">Check the summary, then save. <span data-wizard-js-only hidden><strong>Test connection</strong> asks the bucket with these keys first and stores nothing.</span></p>
					<div id="backup-wizard-result" class="backup-wizard-result" aria-live="polite">
						if v.DestinationCheck.Result != "" {
							@BackupDestinationCheckResult(v.DestinationCheck)
						}
					</div>
					<div class="backup-step-nav">
						<button type="button" class="secondary" data-wizard-back hidden>← Back</button>
						<div class="backup-step-actions">
							<button type="button" class="secondary" data-wizard-check hidden hx-post="/dashboard/admin/backups/destination/check" hx-trigger="backup-wizard-check" hx-target="#backup-wizard-result" hx-swap="innerHTML" hx-disabled-elt="this">Test connection</button>
							<button type="submit">Save destination</button>
						</div>
					</div>
					<p class="muted backup-wizard-save-note">Saving stores the destination; it does not upload anything.</p>
				</fieldset>
			</div>
			<aside class="backup-rail" aria-label="Setup summary">
				<h5>Your destination</h5>
				<dl>
					@backupWizardSummaryRow("Provider", "provider", "1", v.pickedBackupProvider().Name, "not chosen")
					@backupWizardSummaryRow("Endpoint", "endpoint", "2", v.wizardSummaryValue("endpoint"), "not set yet")
					@backupWizardSummaryRow("Region", "region", "2", v.wizardSummaryValue("region"), "not set yet")
					@backupWizardSummaryRow("Bucket", "bucket", "2", v.wizardSummaryValue("bucket"), "not set yet")
					@backupWizardSummaryRow("Prefix", "prefix", "2", backupPathPrefix(v.wizardSummaryValue("prefix")), "none")
					@backupWizardSummaryRow("Keys", "keys", "3", "", "paste in step 3")
				</dl>
			</aside>
		</div>
	</form>
	<script src="/dashboard/static/backups-wizard.js" defer></script>
}

// backupWizardSummaryRow is one line of the setup summary. The script keeps
// it in sync with the form; the keys row only ever says whether both keys
// are filled in, never their value.
templ backupWizardSummaryRow(label, field, step, value, pending string) {
	<div>
		<dt>{ label } <a href={ templ.SafeURL("#backup-wizard-step-" + step) } class="backup-rail-edit" data-wizard-goto={ step }>Edit<span class="visually-hidden">{ " " + label }</span></a></dt>
		if value != "" {
			<dd data-wizard-summary={ field } data-pending={ pending }>{ value }</dd>
		} else {
			<dd data-wizard-summary={ field } data-pending={ pending } class="is-pending">{ pending }</dd>
		}
	</div>
}

// BackupDestinationCheckResult is the result of checking submitted,
// unsaved destination fields: the HTMX fragment of the check route and the
// step 4 slot of the guided setup. Its texts are fixed; only a validation
// reason (a fixed string that never echoes a value) is shown. An unknown
// result renders nothing.
templ BackupDestinationCheckResult(c BackupDestinationCheck) {
	if m := c.message(); m.Title != "" {
		<div class={ backupAlertClass(m.Kind) } role={ m.role() } data-check-result={ c.Result }>
			<p>
				<strong>{ m.Title }</strong>
				{ m.Detail }
				if m.Kind == "success" {
					<span class="muted">Nothing is saved yet: press <strong>Save destination</strong> to keep it.</span>
				} else {
					<span class="muted">Nothing was saved.</span>
				}
				if m.Step != "" {
					{ " " }
					<a href={ templ.SafeURL("#backup-wizard-step-" + m.Step) } data-wizard-goto={ m.Step }>{ m.StepLabel }</a>
				}
			</p>
		</div>
	}
}

// backupFieldError renders a field's validation reason, referenced by the
// field's aria-describedby.
templ backupFieldError(reason string, id string) {
	if reason != "" {
		<span class="field-error" id={ id + "-error" }>{ reason }</span>
	}
}

// backupProviderPicker is the provider select and one hint line for the
// selected provider: its endpoint pattern, region and a short note. The
// server marks the other hints hidden; where :has() is supported CSS shows
// the hint of the option picked since, and backups-wizard.js does the same
// in the guided setup. The choice only drives these hints and the
// placeholders; it is never stored.
templ backupProviderPicker(v BackupsPageView) {
	<div class="backup-field backup-provider-pick">
		<label for="backup-provider">Provider</label>
		<select id="backup-provider" name="provider" aria-describedby="backup-provider-hint">
			for _, p := range backupProviders {
				<option value={ p.ID } selected?={ v.pickedBackupProvider().ID == p.ID } data-endpoint-placeholder={ p.EndpointPlaceholder } data-region-placeholder={ p.RegionPlaceholder }>{ p.Name }</option>
			}
		</select>
		<div class="backup-provider-hints" id="backup-provider-hint" aria-live="polite">
			for _, p := range backupProviders {
				<div class="backup-provider-hint" data-provider-hint={ p.ID } hidden?={ v.pickedBackupProvider().ID != p.ID }>
					<p class="backup-provider-line">Endpoint: <code>{ p.Pattern }</code> · Region: <code>{ p.RegionPlaceholder }</code></p>
					<p>
						@backupProviderNote(p.ID)
					</p>
				</div>
			}
		</div>
	</div>
}

// backupProviderNote is the short help of one provider: where to find its
// endpoint, region and keys.
templ backupProviderNote(id string) {
	switch id {
		case "r2":
			Your Account ID is on <em>R2 › Overview</em>. Create an R2 API token with <em>Object Read &amp; Write</em> scoped to this bucket. Set expiration under the bucket's <em>Settings › Object lifecycle rules</em>.
		case "aws":
			Use the bucket's own region, for example <code>https://s3.us-east-1.amazonaws.com</code> with region <code>us-east-1</code>. The access key needs <code>s3:PutObject</code> and <code>s3:ListBucket</code> on this bucket.
		case "b2":
			Copy the region from the bucket's S3 endpoint, for example <code>https://s3.us-west-004.backblazeb2.com</code> → region <code>us-west-004</code>. Create an application key restricted to this bucket.
		case "wasabi":
			Use the bucket's region endpoint, for example <code>https://s3.eu-central-1.wasabisys.com</code> with region <code>eu-central-1</code>.
		case "do":
			The endpoint is the datacenter, for example <code>https://nyc3.digitaloceanspaces.com</code> with region <code>nyc3</code>. Create a Spaces access key.
		case "minio":
			Use its origin, for example <code>https://minio.internal.example.com:9000</code>. Plain <code>http://</code> is accepted only for <code>localhost</code> and loopback addresses such as <code>127.0.0.1</code>. MinIO's default region is <code>us-east-1</code>.
		case "other":
			Any service that accepts S3 Signature V4 requests over https. Use the region your provider documents, or <code>auto</code> when it has none.
	}
}

templ backupScheduleBlock(v BackupsPageView) {
	<div class="data-frame">
		<p class="section-kicker">SCHEDULE</p>
		<p>
			@StatusBadge(v.scheduleStatusLabel(), v.scheduleStatusVariant())
			if v.Schedule.Configured {
				<span class="muted">{ backupWeekdaysLabel(v.Schedule.Weekdays) } at { v.Schedule.TimeOfDay } { v.Schedule.Timezone }</span>
			}
		</p>
		<p>Next run: <strong>{ formatBackupNextRun(v.NextRun, v.Schedule.Timezone) }</strong></p>
		if v.scheduleFormVisible() {
			<form method="post" action="/dashboard/admin/backups/schedule" class="backup-settings-form backup-schedule-form">
				<fieldset class="weekday-picker">
					<legend>Weekdays</legend>
					for _, day := range backupWeekdayOptions(v.Schedule.Weekdays) {
						<label><input type="checkbox" name="weekday" value={ day.Value } checked?={ day.Checked }/> { day.Label }</label>
					}
				</fieldset>
				<div class="backup-field">
					<label for="backup-schedule-time">Time (24h)</label>
					<input type="time" id="backup-schedule-time" name="time" value={ v.Schedule.TimeOfDay } required { v.scheduleFieldAttrs("time", "backup-schedule-time", false)... }/>
					@backupFieldError(v.scheduleFieldError("time"), "backup-schedule-time")
				</div>
				<div class="backup-field">
					<label for="backup-schedule-timezone">Time zone</label>
					<select id="backup-schedule-timezone" name="timezone" required { v.scheduleFieldAttrs("timezone", "backup-schedule-timezone", true)... }>
						for _, group := range v.timezoneGroups() {
							if group.Region == "" {
								for _, option := range group.Options {
									@backupTimezoneOptionTag(option)
								}
							} else {
								<optgroup label={ group.Region }>
									for _, option := range group.Options {
										@backupTimezoneOptionTag(option)
									}
								</optgroup>
							}
						}
					</select>
					@backupFieldError(v.scheduleFieldError("timezone"), "backup-schedule-timezone")
					<span class="hint" id="backup-schedule-timezone-hint">Offsets shown are today's; runs follow the zone's daylight-saving changes. With the list focused, type a region such as <code>Europe/</code> to jump to it.</span>
				</div>
				<label class="backup-schedule-enabled"><input type="checkbox" name="enabled" value="on" checked?={ v.Schedule.Enabled }/> Enabled</label>
				<div class="backup-submit-row">
					<p class="muted">Saving changes when backups run; it does not upload anything.</p>
					<button type="submit">Save schedule</button>
				</div>
			</form>
		} else if v.settingsFormsVisible() {
			<p class="muted">Configure a destination above before scheduling backups.</p>
		}
		if v.CanRunNow {
			<div class="backup-run-now">
				<form method="post" action="/dashboard/admin/backups/run">
					<button type="submit" class="secondary">Back up now</button>
				</form>
				<p class="muted">Starts one upload to the destination now; it is recorded as <code>backup.run.manual</code> and appears in the history below.</p>
			</div>
		}
	</div>
}

// backupTimezoneOptionTag is one option of the schedule's time zone select.
templ backupTimezoneOptionTag(option backupTimezoneOption) {
	<option value={ option.Value } selected?={ option.Selected }>{ option.Label }</option>
}

templ backupRunHistory(v BackupsPageView) {
	<div class="data-frame">
		<p class="section-kicker">RECENT RUNS</p>
		if len(v.Runs) == 0 {
			<p class="muted">No backup has been uploaded yet.</p>
		} else {
			<table class="data-table">
				<thead>
					<tr>
						<th>Trigger</th>
						<th>Scheduled for</th>
						<th>Started</th>
						<th>Finished</th>
						<th>Status</th>
						<th>Size</th>
						<th>Object key</th>
						<th>Error</th>
					</tr>
				</thead>
				<tbody>
					for _, run := range v.Runs {
						<tr>
							<td>{ run.Trigger }</td>
							<td>{ formatBackupScheduledFor(run.ScheduledFor) }</td>
							<td>{ formatTimeValue(run.StartedAt) }</td>
							<td>{ formatTimeValue(run.FinishedAt) }</td>
							<td>
								@StatusBadge(run.Status, backupRunStatusVariant(run.Status))
							</td>
							<td>{ backupRunSizeLabel(run) }</td>
							<td><code>{ emptyDash(run.ObjectKey) }</code></td>
							<td>{ emptyDash(run.ErrorMessage) }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

// BackupDownloadAdministrationNotice explains why a dashboard admin session
// without a managed admin token cannot download a backup.
templ BackupDownloadAdministrationNotice() {
	<div class="data-frame policy-note">
		<p><strong>Backup download requires a managed admin token.</strong> Sign in with a token issued by <code>engram cloud bootstrap admin --issue-token ...</code>, or run <code>engram cloud backup export</code> on the server.</p>
	</div>
}

// BackupSettingsAdministrationNotice explains why a dashboard admin session
// without a managed admin token sees the backup settings read-only.
templ BackupSettingsAdministrationNotice() {
	<div class="data-frame policy-note">
		<p><strong>Changing scheduled backups requires a managed admin token.</strong> The destination, schedule and history below are read-only for this session.</p>
	</div>
}
